RewriteEngine On
RewriteBase /BookVerse/

# Permitir acceso directo a archivos que existen físicamente
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Permitir acceso directo a directorios que existen físicamente
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# TODAS las rutas van al Router (incluyendo admin y auth)
RewriteRule ^(.*)$ index.php?uri=$1 [QSA,L]